<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ref.title }} ({{ ref.type | upper }}) — LaTeX Reference</title>
    <meta name="robots" content="noindex, nofollow">
    {% include "components/pageheader.njk" %}
    <style>
      .latex-ref-container {
        max-width: 820px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
      }
      .latex-ref-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--text-faint, #444);
        font-size: 0.85rem;
        color: var(--text-muted, #888);
      }
      .latex-ref-badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: var(--background-modifier-accent, #7057ff22);
        color: var(--text-accent, #7057ff);
        border: 1px solid var(--interactive-accent, #7057ff55);
      }
      .latex-ref-id {
        font-family: var(--font-monospace, monospace);
        background: var(--background-secondary, #222);
        padding: 0.15rem 0.4rem;
        border-radius: 3px;
        font-size: 0.8rem;
      }
      .latex-ref-card {
        margin-top: 1rem;
        border-radius: 8px;
        overflow: hidden;
      }
      .latex-ref-footer {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--text-faint, #333);
        font-size: 0.8rem;
        color: var(--text-faint, #666);
        display: flex;
        justify-content: space-between;
      }
    </style>
  </head>
  <body class="theme-{{ meta.baseTheme }} markdown-preview-view markdown-rendered markdown-preview-section">
    <div class="latex-ref-container">
      <div class="latex-ref-meta">
        <div>
          <span class="latex-ref-badge">{{ ref.type }}</span>
          <span class="latex-ref-id">^{{ ref.id }}</span>
        </div>
        <div>
          <span>Approved Reference Snapshot</span>
        </div>
      </div>

      <main class="content cm-s-obsidian">
        <div class="callout" data-callout="{{ ref.type }}">
          <div class="callout-title">
            <div class="callout-title-inner">{{ ref.title }}</div>
          </div>
          <div class="callout-content">
            {{ ref.body | renderLatexRefMarkdown | safe }}
          </div>
        </div>
      </main>

      <div class="latex-ref-footer">
        <span>Source: Academic Notes</span>
        <span>Approved at {{ ref.approvedAt }}</span>
      </div>
    </div>
  </body>
</html>
