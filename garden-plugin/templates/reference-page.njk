<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ref.title }} ({{ ref.type | upper }}) — Mathematical Reference</title>
    <meta name="robots" content="noindex, nofollow">
    {% include "components/pageheader.njk" %}
    <style>
      :root {
        --reference-max-width: 760px;
      }
      html, body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background-color: var(--background-primary);
        color: var(--text-normal);
        display: flex;
        flex-direction: column;
      }
      .latex-ref-wrapper {
        flex: 1 0 auto;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 4rem 1.5rem;
        box-sizing: border-box;
      }
      .latex-ref-card {
        width: 100%;
        max-width: var(--reference-max-width);
        margin: 0 auto;
      }
      .latex-ref-card .callout {
        margin: 0;
        width: 100%;
        box-sizing: border-box;
      }
      .latex-ref-card .callout-content {
        margin: 0;
        padding: var(--size-4-3) var(--size-4-4);
      }
      .latex-ref-source-attribution {
        margin-top: 1.25rem;
        padding: 0 0.25rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: left;
      }
      .latex-ref-source-attribution a {
        color: var(--text-muted);
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.15s ease;
      }
      .latex-ref-source-attribution a:hover {
        color: var(--text-accent, var(--interactive-accent));
      }
      @media (max-width: 640px) {
        .latex-ref-wrapper {
          padding: 2rem 1rem;
        }
      }
    </style>
  </head>
  <body class="theme-{{ meta.baseTheme }} markdown-preview-view markdown-rendered markdown-preview-section">
    <div class="latex-ref-wrapper">
      <main class="latex-ref-card cm-s-obsidian" id="ref-{{ ref.id }}" data-reference-id="{{ ref.id }}" data-content-hash="{{ ref.contentHash }}" role="main">
        <div class="callout" data-callout="{{ ref.type }}">
          <div class="callout-title">
            <div class="callout-title-inner">{{ ref.title }}</div>
          </div>
          <div class="callout-content">
            {{ ref.body | renderLatexRefMarkdown | safe }}
          </div>
        </div>
        {% if sourceAttribution %}
          <div class="latex-ref-source-attribution">
            From <a href="{{ sourceAttribution.url }}">{{ sourceAttribution.title }}</a>
          </div>
        {% endif %}
      </main>
    </div>
    {% include "components/lucideIcons.njk" %}
  </body>
</html>
